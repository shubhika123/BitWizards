# Groq API Key (recommended for Natural Language Search and Explanations)
GROQ_API_KEY=your_groq_api_key_here

# Optional AI / integration keys
GEMINI_API_KEY=your_gemini_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PRUNA_API_KEY=your_pruna_api_key_here
HF_API_KEY=your_huggingface_api_key_here

# Primary DB (SQLModel). Use Supabase Postgres URI in prod, or omit for local SQLite.
# Example: postgresql://postgres.[ref]:[password]@aws-0-....pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase (backend; optional)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# OpenWeather API Key (optional, falls back to simulated weather patterns if not set)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
