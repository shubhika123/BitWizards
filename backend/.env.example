# Gemini API Key (required for Natural Language Search and Explanations)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configurations (optional for DB operations, using mock DB if not set)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# OpenWeather API Key (optional, falls back to simulated weather patterns if not set)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Server Settings
PORT=8000
HOST=0.0.0.0
DEBUG=True
